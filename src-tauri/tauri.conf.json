{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChronoSlab 3D HUD",
  "version": "0.1.2",
  "identifier": "com.chronoslab.hud",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ChronoSlab 3D HUD",
        "width": 900,
        "height": 780,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "resources": [
      "WebView2Loader.dll"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBQjIwNzFCNzg1MzRCNTgKUldSWVMxTjRHd2V5K3FEZkVWVnY1c21ZUDJmeXdDVnhoSEF2Mm01MkNMRUFyczRXU1c2UzZlTlEK",
      "endpoints": [
        "https://github.com/shafayaligit/chornoslab/releases/latest/download/latest.json"
      ]
    }
  }
}
